# Allow only inputs needed to build and run the backend.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!README.md
!src/
!src/**
!config/
!config/**

# Protect against secrets within otherwise allowed directories.
**/.env*
**/*.env
**/*.env.*
**/secrets
**/secrets.*
**/credentials
**/credentials.*
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/.ssh
**/.aws
**/.azure
**/.docker

# Exclude nested metadata, local environments, caches and test artifacts too.
**/.git
**/.hg
**/.svn
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/.cache
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.egg-info
**/.coverage*
**/coverage.xml
**/htmlcov
**/test-results
**/junit*.xml
**/tests
**/test_*.py
**/*_test.py
